+// Bypass the exported VirtualProtect so safetyhook's own page-protection
+// changes never re-enter a user hook installed on VirtualProtect itself.
+// Hooking VirtualProtect with safetyhook otherwise crashes due to the
+// re-entrancy while TrapManager's mutex is held during patch application.
+static bool vm_protect_direct(uint8_t* address, size_t size, uint32_t protect, DWORD* old_protect) {
+    static const auto nt_protect_virtual_memory = []() -> LONG(NTAPI*)(HANDLE, PVOID*, SIZE_T*, ULONG, PULONG) {
+        if (auto* ntdll = GetModuleHandleW(L"ntdll.dll")) {
+            return reinterpret_cast<LONG(NTAPI*)(HANDLE, PVOID*, SIZE_T*, ULONG, PULONG)>(
+                GetProcAddress(ntdll, "NtProtectVirtualMemory"));
+        }
+        return nullptr;
+    }();
+
+    if (nt_protect_virtual_memory == nullptr) {
+        return VirtualProtect(address, size, protect, old_protect) != FALSE;
+    }
+
+    PVOID base = address;
+    SIZE_T region_size = size;
+
+    return nt_protect_virtual_memory(GetCurrentProcess(), &base, &region_size, protect, old_protect) >= 0;
+}
+
 std::expected<uint32_t, OsError> vm_protect(uint8_t* address, size_t size, uint32_t protect) {
     DWORD old_protect = 0;
 
-    if (VirtualProtect(address, size, protect, &old_protect) == FALSE) {
+    if (!vm_protect_direct(address, size, protect, &old_protect)) {
         return std::unexpected{OsError::FAILED_TO_PROTECT};
     }
 
